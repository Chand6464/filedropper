# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DISCORD_BOT_ENDPOINT: The HTTP URL of your hosted Python bot endpoint.
# Example: https://my-discord-bot.onrender.com/api/receive-file
# Kept strictly server-side so it is never exposed in browser developer source code.
DISCORD_BOT_ENDPOINT=

# DISCORD_BOT_SECRET: A secret bearer token shared between this server and your Python bot.
# Sent in the 'Authorization: Bearer <secret>' and 'X-Bot-Secret' request headers.
# Your Python bot verifies this token to reject unauthorized requests from third parties.
DISCORD_BOT_SECRET=

# DISCORD_WEBHOOK_URL / DISCORD_WEBHOOK_API: Direct Discord channel webhook URL.
# If provided, files dropped from phones/PC are forwarded directly into your Discord channel.
# Kept strictly server-side to prevent public users or browser DevTools from seeing your webhook.
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_API=
